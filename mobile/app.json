{
  "expo": {
    "name": "Casa Rwanda",
    "slug": "casa-rwanda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "casarw",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.casahomesrwanda.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Casa uses your location to find homes near you.",
        "NSCameraUsageDescription": "Casa uses your camera to add listing photos and ID verification.",
        "NSMicrophoneUsageDescription": "Casa uses your microphone when recording listing videos.",
        "NSPhotoLibraryUsageDescription": "Casa lets you pick photos for listings from your library.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "config": {}
    },
    "android": {
      "package": "com.casahomesrwanda.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.casahomesrwanda.com",
              "pathPrefix": "/listing"
            },
            {
              "scheme": "https",
              "host": "casahomesrwanda.com",
              "pathPrefix": "/listing"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0f2f24",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDZQw4v0PPjeer5WZn7li6l634bDLGRr4Q"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f2f24"
        }
      ],
      "expo-secure-store",
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#1B8E3E",
          "defaultChannel": "casa-alerts",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyDZQw4v0PPjeer5WZn7li6l634bDLGRr4Q"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Casa uses your camera to add listing photos and ID verification.",
          "photosPermission": "Casa lets you pick photos for listings from your library."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_NEW_EXPO_PROJECT_ID"
      }
    },
    "owner": "ekfuingei"
  }
}
